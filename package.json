{
  "name": "regie-orchestre",
  "version": "0.1.0",
  "private": true,
  "description": "Préparateur de régie vidéo pour orchestre : timeline des instruments, tops et conducteurs caméra.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
